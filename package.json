{
  "name": "wejustkilled",
  "version": "2.0.0",
  "private": true,
  "description": "We Just Killed: a parody case file of startup launch posts that claim to have 'just killed' another product. Static site, no build.",
  "license": "MIT",
  "author": "Tony Kipkemboi",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:py",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"site/**/*.css\"",
    "lint:html": "htmlhint \"site/**/*.html\"",
    "lint:py": "ruff check scripts && ruff format --check scripts",
    "format": "prettier --write . && stylelint \"site/**/*.css\" --fix && ruff format scripts",
    "format:check": "prettier --check .",
    "test:csp": "node scripts/csp-check.mjs",
    "check": "npm run lint && npm run format:check && npm run test:csp",
    "audit": "npm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "4.2.1",
    "globals": "17.14.0",
    "htmlhint": "1.9.2",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "40.0.0"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "glob": "14.0.3"
  }
}
